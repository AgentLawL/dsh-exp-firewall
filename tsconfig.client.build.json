{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "lib/types/client",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "client",
    "sourceMap": false
  },
  "include": ["client"]
}
